# Copy to .env and edit before `docker compose up`
POSTGRES_USER=carwash
POSTGRES_PASSWORD=carwash_secret_change_me
POSTGRES_DB=carwash

# REQUIRED – generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h

APP_PORT=4000
CORS_ORIGIN=http://localhost:4000
TZ=Africa/Cairo
# Country code used to normalise local mobile numbers (20 = Egypt, 962 = Jordan)
DEFAULT_COUNTRY_CODE=20

# First-run admin account (only used when the database is empty)
ADMIN_EMAIL=admin@carwash.local
ADMIN_PASSWORD=Admin@12345
# Load realistic demo compounds/owners/vehicles/subscriptions on first run (set false for production)
SEED_DEMO=true

# Public URL used inside SMS links (set automatically from DOMAIN in docker-compose.prod.yml)
# PUBLIC_URL=https://carwash.example.com
